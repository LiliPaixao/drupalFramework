Subject: [PATCH] Exception for when library is invalid and missing a /

---
 core/lib/Drupal/Core/Asset/AssetResolver.php     | 16 ++++++++++++++++
 .../Asset/Exception/InvalidLibraryException.php  | 10 ++++++++++
 2 files changed, 26 insertions(+)
 create mode 100644 core/lib/Drupal/Core/Asset/Exception/InvalidLibraryException.php

diff --git a/core/lib/Drupal/Core/Asset/AssetResolver.php b/core/lib/Drupal/Core/Asset/AssetResolver.php
index e853f63b78..f311f56b49 100644
--- a/core/lib/Drupal/Core/Asset/AssetResolver.php
+++ b/core/lib/Drupal/Core/Asset/AssetResolver.php
