<?php

/**
 * @file
 * Theme functions.
 */

// Include all files from the includes directory.
$includes_path = __DIR__ . '/includes/*.theme';
foreach (glob($includes_path) as $file) {
  require_once __DIR__ . '/includes/' . basename($file);
}

/**
 * Preprocessa a página para injetar o paragraph `field_header_hero`
 * na região `page.header` e evitar duplicação em `page.content`.
 */
function observatorio_preprocess_page(array &$variables) {
  if (!empty($variables['node']) && $variables['node']->hasField('field_header_hero')) {
    $paragraph = $variables['node']->get('field_header_hero')->first()?->entity;
    if ($paragraph) {
      // Renderiza o paragraph e coloca na região "header".
      $variables['page']['header'] = \Drupal::entityTypeManager()
        ->getViewBuilder('paragraph')
        ->view($paragraph, 'default');

      // Remove do conteúdo da página para não aparecer duplicado.
      unset($variables['page']['content']['system_main']['nodes'][$variables['node']->id()]['field_header_hero']);
    }
  }
}
