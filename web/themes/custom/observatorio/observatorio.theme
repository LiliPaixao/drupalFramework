<?php

/**
 * @file
 * Theme functions.
 */

// Include all files from the includes directory.
$includes_path = __DIR__ . '/includes/*.theme';
foreach (glob($includes_path) as $file) {
  require_once __DIR__ . '/includes/' . basename($file);
}

/**
 * Preprocessa a página para injetar o paragraph `field_header_hero`
 * na região `page.header` e evitar duplicação em `page.content`.
 */
function observatorio_preprocess_page(array &$variables): void {
  if (!empty($variables['node']) && $variables['node'] instanceof \Drupal\node\NodeInterface) {
    $node = $variables['node'];

    if ($node->hasField('field_header_hero') && !$node->get('field_header_hero')->isEmpty()) {
      /** @var \Drupal\Core\Field\EntityReferenceFieldItemList $field */
      $field = $node->get('field_header_hero');

      $view_builder = \Drupal::entityTypeManager()->getViewBuilder('paragraph');

      /** @var \Drupal\paragraphs\Entity\Paragraph[] $paragraphs */
      $paragraphs = $field->referencedEntities();

      if (!empty($paragraphs)) {
        $header_hero = reset($paragraphs);
        $variables['page']['header'] = $view_builder->view($header_hero);
      }
    }
  }
}

