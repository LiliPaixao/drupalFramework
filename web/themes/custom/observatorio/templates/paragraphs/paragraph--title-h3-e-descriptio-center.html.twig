{# 
/**
* Template customizado para o tipo Paragraph "title_h3_e_descriptio_center".
*/
#}
<div{{ attributes.addClass('text-start', 'p-5') }}>
    {% if content.field_title %}
        <h3 class="mb-3">{{ content.field_title }}</h3>
    {% endif %}

    {% if content.field_description %}
        <p class="lead">{{ content.field_description }}</p>
    {% endif %}
</div>