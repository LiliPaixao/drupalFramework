<div {{ attributes.addClass('header-hero', 'd-flex', 'flex-md-row', 'align-items-start', 'py-5' ) }}>
    <div class="container py-4">
        <div class="row w-100 d-flex justify-content-center align-items-center">
            <div class="text-content col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 text-start text-md-center justify-content-center">
                {% if content.field_title %}
                    <h1 class="mb-4">{{ content.field_title }}</h1>
                {% endif %}

                {% if content.field_description %}
                    <p class="lead mb-4">{{ content.field_description['#items'][0].value }}</p>
                {% endif %}

                {% if paragraph.field_link.0.url %}
                    <a class="btn btn-link" href="{{ paragraph.field_link.0.url }}" role="button">
                        {{ paragraph.field_link.0.title ?: 'Clique aqui' }}
                    </a>
                {% endif %}

                {% if paragraph.field_link_second.0.url %}
                    <a class="btn btn-outline-primary" href="{{ paragraph.field_link_second.0.url }}" role="button">
                        {{ paragraph.field_link_second.0.title ?: 'Clique aqui' }}
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</div>