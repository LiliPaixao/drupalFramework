{#
  Tema personalizado para o carrossel Slick
  Este arquivo deve ser modificado para se adequar ao seu layout e estilo.
#}

<div class="slick-carousel">
  {# Loop sobre os itens do carrossel #}
  {% for item in items %}
    <div class="slick-item">
      <div class="slick-content">
        {# Exemplo: Exibir a imagem do item #}
        <img src="{{ item.image }}" alt="{{ item.alt_text }}" />
        
        {# Exemplo: Exibir título do item #}
        <h2>{{ item.title }}</h2>

        {# Exemplo: Exibir descrição do item #}
        <p>{{ item.description }}</p>
      </div>
    </div>
  {% endfor %}
</div>

{# Se o carrossel precisar de controles, como setas ou indicadores, adicione aqui #}