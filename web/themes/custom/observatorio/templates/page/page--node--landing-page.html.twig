{#
/**
 * Template for landing page node.
 *
 * This template is used for the landing page node type.
 */
#}

{% set page_attributes = attributes ?: create_attribute() %}
{% set page_classes = ['page']|merge(page_utility_classes ?: []) %}

{# Navbar superior #}
{% if page.navbar_up %}
  <div class="region-navbar-up bg-light sticky-top me-auto py-2">
    <div class="container-fluid d-flex justify-content-end">
      {{ page.navbar_up }}
    </div>
  </div>
{% endif %}

<div {{ page_attributes.addClass(page_classes) }}>

  {% block page_navigation %}
    {% include 'observatorio:page-navigation' %}
  {% endblock %}

  {% block page_content %}
    <main{{ content_attributes.addClass(page_main_classes) }}>
      {# Check if there is a header #}
      {% if page.header %}
        <header class="page__header">
          <div {{ page_header_container_attributes.addClass(page_header_container_classes) }}>
            {# Render the page header which contains the paragraph #}
            {{ page.header }}
          </div>
        </header>
      {% endif %}

      {% if page.content %}
        <div class="page__content" id="main-content">
          {# Removed the 'container' class for the landing page #}
          <div {{ page_content_container_attributes.addClass(page_content_container_classes) }}>
            {% block page_inner_content %}
              {{ page.content }}
            {% endblock %}
          </div>
        </div>
      {% endif %}
    </main>
  {% endblock %}

  {% block page_footer %}
    {% include 'observatorio:page-footer' with { footer_utility_classes: ['utility-class'] } %}
  {% endblock %}

  {# New bottom footer #}
  {% if page.footer_bottom %}
    <div class="region-footer-bottom d-flex flex-wrap justify-content-md-between align-items-md-center py-3">
      <div class="container">
        {{ page.footer_bottom }}
      </div>
    </div>
  {% endif %}
</div>
