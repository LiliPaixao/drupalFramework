{% block block_content %}
  {% if content %}
    {# Mantém a estrutura do bloco com as configurações do Layout Builder, 
        mas adiciona as classes necessárias #}
    <div {{ attributes.addClass('header-hero', 'd-flex', 'flex-md-row', 'align-items-start') }}>
      
      {# Inclui o template hero.twig passando o conteúdo do bloco e os atributos #}
      {% include '@observatorio/components/hero/hero.twig' with {
        content: content,
        content_attributes: content_attributes,
        block_attributes: attributes
      } %}

    </div>
  {% endif %}
{% endblock %}

