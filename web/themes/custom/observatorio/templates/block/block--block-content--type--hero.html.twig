{#
/**
 * @file
 * Template for a Block component.
 *
 * Available variables:
 * - layout: String that will determine the layout of the block.
 * - plugin_id: The ID of the block implementation.
 * - label: The configured label of the block if visible.
 * - configuration: A list of the block's configuration values.
 *   - label: The configured label for the block.
 *   - label_display: The display settings for the label.
 *   - provider: The module or other provider that provided this block plugin.
 *   - Block plugin specific settings will also be stored here.
 * - content: The content of this block.
 * - attributes: array of HTML attributes populated by modules, intended to
 *   be added to the main container tag of this template.
 * - id: A valid HTML ID and guaranteed unique.
 * - title_attributes: Same as attributes, except applied to the main title
 *   tag that appears in the template.
 * - content_attributes: Same as attributes, except applied to the main content
 *   tag that appears in the template.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 * - block_html_tag: The HTML tag for the block.
 * @see template_preprocess_block()
 *
 * @ingroup themeable
 */
#}
{% set block_attributes = attributes ?: create_attribute() %}
{% set block_html_tag = block_html_tag ?? 'div' %}

{%
  set block_classes = [
    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
    layout ? 'layout--' ~ layout|clean_class,
    bundle ? 'block--' ~ bundle|clean_class : "",
    id ? 'block--' ~ id|replace({"_": "-"})|clean_class : "",
  ]|merge(block_utility_classes ?: [])
%}

{%
  set block_content_classes = [
    'block__content',
  ]|merge(block_content_utility_classes ?: [])
%}

{% if block_html_tag %}
<{{block_html_tag}} {{ block_attributes|without('id').addClass(block_classes) }}>
  {% endif %}

    {{ title_prefix }}
    {% block block_label %}
      {% if label %}
        {%
          include 'radix:heading' with {
            heading_attributes: title_attributes,
            content: label,
            heading_html_tag: heading_html_tag|default('h2'),
            heading_utility_classes: heading_utility_classes|default(['block__title']),
          }
        %}
      {% endif %}
    {% endblock %}
    {{ title_suffix }}

     {% block block_content %}
      {% if content %}
        {# Mantém a estrutura do bloco e aplica as classes necessárias #}
        
        <div {{ attributes.addClass('header-hero', 'd-flex', 'flex-md-row', 'align-items-start') }}>
          <div class="container">
              <div class="row d-flex justify-content-between align-items-center">
              <div class="text-content col-12 col-sm-9 col-md-6 col-lg-6 col-xl-6 col-xxl-6 text-start text-md-start justify-content-center pt-5 pt-md-0">
                  {% if content.field_title %}
                  <h1 class="mb-4" >{{ content.field_title }}</h1>
                  {% endif %}
              
                  {% if content.field_description %}
                  <p class="lead">{{ content.field_description[0]['#context']['value'] }}</p>
                  {% endif %}
                  
                  {% if content.field_link %}
                  <a class="btn btn-link btn-block-mobile" href="{{ content.field_link[0]['#url'] }}">{{ content.field_link[0]['#title'] }}</a>
                  {% endif %}
              </div>
              
              <div class="image-content col-12 col-sm-9 col-md-4 text-end mt-4 mt-md-0">
                  {% if content.field_image %}
                  {% set image = content.field_image[0] %}
                      {% set image_url = file_url(image['#item'].entity.uri.value) %}
                      <img src="{{ image_url }}" alt="{{ image['#item'].alt }}" />
                  {% endif %}
              </div>
              </div>
          </div>
        </div> 
          

      {% endif %}
    {% endblock %}

{% if block_html_tag %}
  </{{block_html_tag}}>
{% endif %}

