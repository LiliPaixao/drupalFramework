
<div {{ attributes.addClass('header-hero', 'd-flex', 'flex-md-row', 'align-items-start') }}>
    <div class="container">
        <div class="row d-flex justify-content-between align-items-center">
        <div class="text-content
            {% if hero_text_mode or hero_two_links_mode %} col-12 text-center justify-content-center py-5 mx-auto {% else %} col-12 col-sm-9 col-md-6 col-lg-6 col-xl-6 col-xxl-6 text-start text-md-start justify-content-center pt-5 pt-md-0 {% endif %}">
            {% if content.field_title %}
            <h1 class="mb-4">{{ content.field_title }}</h1>
            {% endif %}
        
            {% if content.field_description %}
            <p class="lead mb-4">{{ content.field_description[0]['#context']['value'] }}</p>
            {% endif %}
            
            {% if hero_two_links_mode and content.field_link and content.field_second_link %}
              <div class="d-block d-md-flex gap-2 justify-content-center">
                <a class="btn btn-link mb-2 mb-md-0" href="{{ content.field_link[0]['#url'] }}">{{ content.field_link[0]['#title'] }}</a>
                <a class="btn btn-outline-primary" href="{{ content.field_second_link[0]['#url'] }}">{{ content.field_second_link[0]['#title'] }}</a>
              </div>
            {% elseif content.field_link %}
              <a class="btn btn-link btn-block-mobile" href="{{ content.field_link[0]['#url'] }}">{{ content.field_link[0]['#title'] }}</a>
            {% endif %}
        </div>
        
        {% if not hero_text_mode and not hero_two_links_mode %}
        <div class="image-content col-12 col-sm-9 col-md-4 text-end mt-4 mt-md-0">
            {% if content.field_image %}
            {% set image = content.field_image[0] %}
                {% set image_url = file_url(image['#item'].entity.uri.value) %}
                <img src="{{ image_url }}" alt="{{ image['#item'].alt }}" />
            {% endif %}
        </div>
        {% endif %}
        </div>
    </div>
</div>