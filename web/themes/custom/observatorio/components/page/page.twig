{#
/**
 * @file
 * Template for the main page.
 */
#}
{% set page_attributes = attributes ?: create_attribute() %}
{% set 
  page_classes = [
    'page',
  ]|merge(page_utility_classes ?: []) 
%}

{# Navbar superior #}
{% if page.navbar_up %}
  <div class="region-navbar-up bg-light sticky-top me-auto py-2">
    <div class="container d-flex justify-content-end">
      {{ page.navbar_up }}
    </div>
  </div>
{% endif %}



<div {{ page_attributes.addClass(page_classes) }}>
	
  {% block page_navigation %}
		{% include 'observatorio:page-navigation' %}
	{% endblock %}

  
  {% block page_content %}
    {% include 'observatorio:page-content' with {
      page_header_container_type: 'fluid',
      page_header_container_utility_classes: ['mb-3'],
    }
    %}
  {% endblock %}

	{% block page_footer %}
		{% include 'observatorio:page-footer'  with {
      footer_utility_classes: ['utility-class'],
      }
    %}
	{% endblock %}

  {# Novo rodapé inferior #}
{% if page.footer_bottom %}
  <div class="region-footer-bottom d-flex flex-wrap justify-content-md-between align-items-md-center py-3">
    <div class="container">
      {{ page.footer_bottom }}
    </div>
  </div>
{% endif %}
</div>
