{#
/**
 * @file
 * Template for the main page.
 */
#}
{% set page_attributes = attributes ?: create_attribute() %}
{% set 
  page_classes = [
    'page',
  ]|merge(page_utility_classes ?: []) 
%}

<div {{ page_attributes.addClass(page_classes) }}>
	{% block page_navigation %}
		{% include 'observatorio:page-navigation' %}
	{% endblock %}

  {% block page_content %}
    {% include 'observatorio:page-content' with {
      page_main_utility_classes: ['py-1'],
      page_header_container_utility_classes: ['mb-3'],
      page_content_container_type: FALSE,
      }
    %}
  {% endblock %}

	{% block page_footer %}
		{% include 'observatorio:page-footer'  with {
      footer_utility_classes: ['utility-class'],
      }
    %}
	{% endblock %}
</div>
